{
  "name": "nodejs-react-fastify-rest",
  "version": "1.6.2-alpha.0",
  "private": true,
  "description": "React + Fastify TypeScript reference stack for IDP.",
  "scripts": {
    "lint:md": "markdownlint-cli2 \"*.md\" \"!CHANGELOG.md\"",
    "start:web": "tsx web/server.ts",
    "start:bff": "tsx bff/src/server.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck:web": "tsc --project web/tsconfig.json --noEmit",
    "typecheck:bff": "tsc --project bff/tsconfig.json --noEmit",
    "typecheck:stack": "npm run typecheck:web && npm run typecheck:bff",
    "test:bff": "node --import tsx --test \"bff/src/**/*.test.ts\"",
    "test:stack": "npm run typecheck:stack && npm run test:bff"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@tanstack/react-query": "^5.100.7",
    "fastify": "^5.8.5",
    "openid-client": "^6.8.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.14.2",
    "zod": "^4.4.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.1",
    "markdownlint-cli2": "0.22.1",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  }
}
