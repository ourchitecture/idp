{
  "name": "idp",
  "version": "1.0.0",
  "private": true,
  "description": "Intent-Driven Portal (IDP)",
  "license": "MIT",
  "scripts": {
    "lint:md": "markdownlint-cli2",
    "start:web": "make -C \"stacks/go/net-http/rest\" run-web",
    "start:bff": "make -C \"stacks/go/net-http/rest\" run-bff",
    "start:web:react-fastify": "tsx stacks/nodejs/react-fastify/rest/web/server.ts",
    "start:bff:react-fastify": "tsx stacks/nodejs/react-fastify/rest/bff/src/server.ts",
    "build:web:react-fastify": "vite build --config stacks/nodejs/react-fastify/rest/web/vite.config.ts",
    "typecheck:web:react-fastify": "tsc --project stacks/nodejs/react-fastify/rest/web/tsconfig.json --noEmit",
    "typecheck:bff:react-fastify": "tsc --project stacks/nodejs/react-fastify/rest/bff/tsconfig.json --noEmit",
    "typecheck:stack:react-fastify": "npm run typecheck:web:react-fastify && npm run typecheck:bff:react-fastify",
    "test:contract": "tsx tests/src/index.ts",
    "test:contract:watch": "tsx watch tests/src/index.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@tanstack/react-query": "^5.90.10",
    "fastify": "^5.6.1",
    "nodejs-react-fastify-rest-lint": "file:stacks/nodejs/react-fastify/rest",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.14.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "markdownlint-cli2": "^0.21.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.4.5",
    "vite": "^7.3.2"
  }
}
