{
  "name": "@ourchitecture-internal/backstage-plugin-stemix-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Stemix greeting backend plugin for the local Backstage harness.",
  "license": "MIT",
  "backstage": {
    "role": "backend-plugin",
    "inline": true,
    "pluginId": "stemix",
    "pluginPackages": [
      "@ourchitecture/backstage-plugin-stemix",
      "@ourchitecture-internal/backstage-plugin-stemix-frontend",
      "@ourchitecture-internal/backstage-plugin-stemix-backend"
    ],
    "features": {
      ".": "@backstage/BackendFeature"
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "start": "backstage-cli package start",
    "build": "tsc --project tsconfig.json && backstage-cli package build",
    "lint": "yarn run typecheck",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "clean": "rm -rf dist dist-types node_modules",
    "typecheck": "tsc --project tsconfig.json",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/backend-plugin-api": "^1.9.0",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@backstage/cli": "^0.34.6",
    "@types/express": "^4.17.21",
    "typescript": "~5.4.5"
  }
}
