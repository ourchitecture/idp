{
  "name": "@ourchitecture/backstage-plugin-stemix",
  "version": "0.1.0",
  "description": "Stemix Backstage plugin bundle with frontend root exports and backend subpath exports.",
  "license": "MIT",
  "backstage": {
    "role": "common-library",
    "pluginId": "stemix",
    "pluginPackages": [
      "@ourchitecture/backstage-plugin-stemix",
      "@ourchitecture-internal/backstage-plugin-stemix-frontend",
      "@ourchitecture-internal/backstage-plugin-stemix-backend"
    ]
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "exports": {
    ".": "./src/index.ts",
    "./backend": "./src/backend.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "backend": [
        "src/backend.ts"
      ]
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json && backstage-cli package build",
    "lint": "yarn run typecheck",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "clean": "rm -rf dist dist-types node_modules",
    "typecheck": "tsc --project tsconfig.json",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/backend-plugin-api": "^1.9.0",
    "@backstage/core-components": "^0.15.0",
    "@backstage/core-plugin-api": "^1.9.0",
    "@material-ui/core": "^4.12.4",
    "@ourchitecture-internal/backstage-plugin-stemix-backend": "workspace:*",
    "@ourchitecture-internal/backstage-plugin-stemix-frontend": "workspace:*",
    "express": "^4.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@backstage/cli": "^0.29.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "tsx": "^4.20.6",
    "typescript": "~5.4.5"
  },
  "peerDependencies": {
    "@types/react": "^18.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0"
  },
  "sideEffects": false
}
