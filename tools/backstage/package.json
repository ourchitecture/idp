{
  "name": "stemix-idp-backstage",
  "version": "0.1.0",
  "private": true,
  "description": "Backstage test harness for Stemix IDP plug-in integration.",
  "license": "MIT",
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "scripts": {
    "dev": "concurrently \"yarn dev:app\" \"yarn dev:backend\"",
    "dev:app": "yarn workspace app start",
    "dev:backend": "yarn workspace backend start",
    "build": "yarn workspaces foreach -A run build",
    "build:all": "yarn run build",
    "start": "yarn workspace app start",
    "start-backend": "yarn workspace backend start",
    "typecheck": "yarn workspaces foreach -A run typecheck",
    "clean": "yarn workspaces foreach -A run clean"
  },
  "devDependencies": {
    "@backstage/cli": "^0.29.0",
    "@backstage/cli-common": "^0.1.14",
    "concurrently": "^8.2.2",
    "typescript": "~5.4.5"
  },
  "resolutions": {
    "@types/react": "^18",
    "@types/react-dom": "^18"
  },
  "prettier": {},
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.1.2"
}
