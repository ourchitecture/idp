# See https://github.com/moonrepo/proto/releases
proto = "0.57.1"
# See https://github.com/moonrepo/moon/releases
moon = "2.2.4"
# See https://go.dev/doc/devel/release
go = "1.26.0"
# See https://nodejs.org/en/download
node = "24.15.0"
npm = "bundled"
# See https://github.com/yarnpkg/berry/releases
yarn = "4.14.1"
# See https://github.com/pnpm/pnpm/releases
pnpm = "11.1.2"
# See https://www.python.org/downloads/
python = "3.14.5"
# See https://github.com/astral-sh/uv/releases
uv = "0.11.14"
# See https://github.com/jqlang/jq/releases
jq = "1.8.1"
# See https://adoptium.net/temurin/releases
openjdk = "25.0.3+9"
# See https://github.com/gitleaks/gitleaks/releases
gitleaks = "8.30.1"
# See https://github.com/aquasecurity/trivy/releases
trivy = "0.70.0"

[settings]
detect-strategy = "prefer-prototools"
auto-install = true

[plugins.tools]
gitleaks = "github://muuvmuuv/proto-plugins/gitleaks_tool"
jq = "https://raw.githubusercontent.com/appthrust/proto-toml-plugins/main/jq/plugin.toml"
openjdk = "github://eplightning/openjdk-adoptium-proto-plugin"
trivy = "https://raw.githubusercontent.com/ageha734/proto-plugins/refs/heads/master/toml/trivy.toml"
